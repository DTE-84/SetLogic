rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

    // Helper function to check if the user is the owner of the record
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles: Users can read/write their own profile
   match /users/{userId}/{document=**} {
  allow read, write: if request.auth != null && request.auth.uid == userId;
}
      
      // Nested collections under user
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Community Feed: Authenticated users can read all, write their own
    match /nexus_feed/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Food Vault: Global read, write requires auth
    match /food_vault/{foodId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
